+_IX_TAG_RE = re.compile(r"<ix:non(?:Fraction|Numeric)[^>]*>", re.I)
+_IX_ATTR_NAME_RE = re.compile(r'\bname="([^"]+)"')
+_IX_ATTR_CTX_RE = re.compile(r'\bcontextRef="([^"]+)"')
+
