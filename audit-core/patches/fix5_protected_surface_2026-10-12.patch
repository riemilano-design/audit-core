+    (長さ・``LABEL_DENY``・``【】``)を当てる。並びは要素名の順(決めておく)。
+    """
+
+    labels = taxonomy_label_map(namespaces, directory)
+    found = {}
+    for local in sorted(fact_locals):
+        word = labels.get(local)
