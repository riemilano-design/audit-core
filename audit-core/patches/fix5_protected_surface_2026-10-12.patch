+
+def inline_labels(z, names, statement_only=False, contexts=None):
+    """``{日本語の勘定科目名: [要素の局所名, ...]}``。除く名前は適用済み。
+
+    ``statement_only`` は §7a。真のときは ``contexts``
+    (``load_instance`` の ``contexts``)が要る ― member が付いているかを見るため。
+    """
