+_PRIOR_CUE_WINDOW = 15           # A-1: 数の手前の窓(字)
+_PAREN_PRIOR_RE = re.compile(r"[(（]\s*(前連結会計年度は|前期は|同)")  # B-2: 括弧で前期を併記する形
+
