+def _number_spans(s):
+    """同じ文の数の span 一覧(位置順)。A-2 の「手がかりと数の間に別の数があるか」に使う。"""
+    return [(a, b) for (a, b, _v, _u, _p) in E.iter_numbers(s)]
+
+
+def _inside_prior_paren(s, a):
+    """B-2: 数 a が「(前連結会計年度は…)」「(前期は…)」「(同…)」の括弧の中にあるか。"""
+    open_pos = max(s.rfind("(", 0, a), s.rfind("（", 0, a))
+    if open_pos < 0:
+        return False
+    close_pos = min(x for x in (s.find(")", open_pos), s.find("）", open_pos)) if x >= 0) if any(x >= 0 for x in (s.find(")", open_pos), s.find("）", open_pos))) else len(s)
+    if not (open_pos < a < close_pos):
+        return False
+    return bool(_PAREN_PRIOR_RE.match(s, open_pos))
+
+
+def _period_of_number(s, a, spans):
+    """A-1/A-2: 数 a の期間("CurrentYear" か "Prior1Year")を、文の語だけで決める。
+    手がかり(前期・前期末・前連結会計年度)が数の手前 15 字以内にあり、その手がかりと数の間に
+    別の数が無ければ前期。「同」は直前の数と同じ期間。どれも無ければ当期(既定値)。"""
+    if _inside_prior_paren(s, a):   # B-2: 「(前連結会計年度は…)」「(前期は…)」「(同…)」の中の数は前期の水準
+        return "Prior1Year"
+    idx = next((i for i, (x, _y) in enumerate(spans) if x == a), None)
+    left = s[max(0, a - _PRIOR_CUE_WINDOW):a]
+    base = max(0, a - _PRIOR_CUE_WINDOW)
+    prev_end = spans[idx - 1][1] if (idx is not None and idx > 0) else -1
+    for m in _PRIOR_CUE_RE.finditer(left):
+        cue_end = base + m.end()
+        if prev_end >= cue_end:      # A-2: 手がかりの後に別の数がある → その数のもの
+            continue
+        return "Prior1Year"
+    if idx is not None and idx > 0:
+        between = s[spans[idx - 1][1]:a]
+        if _SAME_CUE_RE.search(between) and not _PRIOR_CUE_RE.search(between):
+            return _period_of_number(s, spans[idx - 1][0], spans)   # 「同」= 直前の数と同じ期間
+    return "CurrentYear"
+
 
