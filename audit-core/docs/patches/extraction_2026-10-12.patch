+_DIFF_AFTER_WINDOW = 12          # B-1: 増減語を探す数の後ろの窓(字)。同じ文の中(s は 1 文)
+_PRIOR_CUE_RE = re.compile(r"(前期末|前期|前連結会計年度)")   # A-1
