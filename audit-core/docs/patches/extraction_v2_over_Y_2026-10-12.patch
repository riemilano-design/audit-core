+class SentenceOfRealDocuments(unittest.TestCase):
+    """1B / 5F の行は、書類の同じ id の文・位置と一致する(試験の文が本物であること)。"""
+
+    @classmethod
+    def setUpClass(cls):
+        spn = {}
+        orig = R._dispatch_num_claim
+
+        def spy(claim, s, a, b, *rest):
+            spn[claim["id"]] = (s, a, b)
+            return orig(claim, s, a, b, *rest)
+
+        cls.real = {}
+        R._dispatch_num_claim = spy
+        try:
+            for tag, doc, prof in (("1B", M.DOC_1, V.P1), ("5F", M.DOC_5, V.P5F)):
+                spn.clear()
+                cls.claims = {}
+                num, _ = R.build_raw_claims(M.load_zip_bytes(doc["docID"], doc["sha256"]), prof)
+                cls.real[tag] = (dict(spn), {c["id"]: c for c in num})
+        finally:
+            R._dispatch_num_claim = orig
+
+    def test_literal_sentences_are_the_documents(self):
+        for doc, cid, marked, _p, _q, _w in ROWS:
+            if doc not in ("1B", "5F"):
+                continue
+            s, a, b = _unmark(marked)
+            self.assertEqual(self.real[doc][0][cid], (s, a, b), "%s %s" % (doc, cid))
+
+    def test_bound_pointers_follow_the_assignment(self):
+        # 束縛できた金額の数では、pointer の形(対 = 2 本 + a-b / 単一 = 1 本)と期間が割当どおり
+        checked = 0
+        for tag, (spn, claims) in self.real.items():
+            for cid, (s, a, b) in spn.items():
+                c = claims[cid]
+                if c.get("unit") not in V.UNIT_SCALE or not c.get("bound"):
+                    continue
+                period, pair = R._assign_period_form(s, a, b)
+                p = c["pointer"]
+                self.assertEqual(isinstance(p, list), pair, "%s %s" % (tag, cid))
+                first = (p if isinstance(p, list) else [p])[0].split("@")[1]
+                self.assertTrue(first.startswith("Prior1Year" if period == "Prior1" else "CurrentYear"), "%s %s %s" % (tag, cid, first))
+                checked += 1
+        self.assertGreater(checked, 20)
