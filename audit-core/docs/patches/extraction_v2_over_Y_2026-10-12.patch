+class AssignPeriodFormTable(unittest.TestCase):
+    def test_every_row_of_section_2_1(self):
+        for doc, cid, marked, period, pair, why in ROWS:
+            s, a, b = _unmark(marked)
+            self.assertTrue(any(x == a and y == b for (x, y, _v, _u, _p) in E.iter_numbers(s)),
+                            "%s %s: 印の位置が iter_numbers の数と一致しない" % (doc, cid))
+            self.assertEqual(R._assign_period_form(s, a, b), (period, pair), "%s %s (%s)" % (doc, cid, why))
+
+    def test_assignment_takes_only_the_sentence_and_the_position(self):
+        # R-4: 値(fact の値・match_value・target)は割当に入らない
+        self.assertEqual(list(inspect.signature(R._assign_period_form).parameters), ["s", "a", "b"])
+
+    def test_prior_is_never_a_pair(self):
+        # C-1: 期間が前期なら必ず単一
+        for doc, cid, marked, period, pair, why in ROWS:
+            s, a, b = _unmark(marked)
+            per, p = R._assign_period_form(s, a, b)
+            if per == "Prior1":
+                self.assertFalse(p, "%s %s" % (doc, cid))
+
+    def test_other_money_numbers_in_the_same_sentence_do_not_borrow_the_word(self):
+        # 同じ文でも数ごとに決まる: N015 の 1 つ目だけが対、(前連結会計年度は…増加) の中の数は単一の前期
+        s, a, b = _unmark(ROWS[0][2])
+        spans = [(x, y) for (x, y, _v, _u, _p) in E.iter_numbers(s)]
+        got = [R._assign_period_form(s, x, y) for (x, y) in spans]
+        self.assertEqual(got, [("Current", True), ("Prior1", False), ("Current", False), ("Prior1", False)])
+
