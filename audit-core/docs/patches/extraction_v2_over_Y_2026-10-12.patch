+# 抽出の封 v2(EXTRACTION_SEAL_V2_2026-10-12 §2、D-015)。金額の数 1 つごとに、
+# 期間(当期 / 前期)と形(単一 / 対)を **文の字面だけ** で決める。
+# 値(match_value・target・fact の値)はここに一切入らない(§2 R-4)。
+# 正本は fixtures/xbrl/premeasure_assign_2026-10-12.py の v2_rule。
+# ---------------------------------------------------------------------------
+_PRIOR_PAREN_RE = re.compile(r"[(（]\s*(前連結会計年度は|前期は|同)")
+_PRIOR_CUE_RE = re.compile(r"(前期末|前期|前連結会計年度)")
+_FLOW_BEFORE_RE = re.compile(r"(増加額|減少額)$")                            # R-2f
+_DIFFW = r"(?:(?:増加|減少)(?!額)|(?:増益|減益|増収|減収)額?)"                  # 増加額・減少額は含まない
+_BARE = r"[増減](?![一-龥])"                                                  # 減価・減損などの複合語を除く
+_F1_RE = re.compile(r"(?:" + _DIFFW + r"|比べて?)$")                            # 数の直前(隙間 0)
+_F2_RE = re.compile(r"^(?:の)?(?:" + _DIFFW + r"|" + _BARE + r")")             # 数の直後(隙間 0・「の」1 つまで)
+_F3_RE = re.compile(r"^[(（][^()（）%％]*[)）]の?" + _DIFFW)                    # 数 + (…)の増減語(括弧の中に % が無い)
+_F5_RE = re.compile(r"^[、,]\s*[0-9.,]+[%％]の?(?:大幅な?)?" + _DIFFW)          # 数、P%の増減語
+_BASELINE_AFTER_CUE_RE = re.compile(r"^末?(?:に|と)?(?:比べ|比して|対し)")      # 「前期に比べ」= 比較の基準
+
+
+def _inside_prior_paren(s, a):
+    """数(位置 a)が (前連結会計年度は…)・(前期は…)・(同…) の括弧の中にあるか。"""
+
+    o = max(s.rfind("(", 0, a), s.rfind("（", 0, a))
+    if o < 0:
+        return False
+    cl = [x for x in (s.find(")", o), s.find("）", o)) if x >= 0]
+    c = min(cl) if cl else len(s)
+    return o < a < c and bool(_PRIOR_PAREN_RE.match(s, o))
+
+
+def _assign_period_form(s, a, b):
+    """封 v2 R-1〜R-3。返り値 (period, pair): period は "Current" か "Prior1"、
+    pair は (当期 − 前期) の対にするか(偽なら単一)。文と数の位置だけを見る。
+    """
+
+    spans = [(x, y) for (x, y, _v, _u, _p) in E.iter_numbers(s)]
+    # R-1 期間
+    period = "Current"
+    if _inside_prior_paren(s, a):
+        period = "Prior1"
+    else:
+        idx = next((i for i, (x, _y) in enumerate(spans) if x == a), None)
+        base = max(0, a - 15)
+        left_cue = s[base:a]
+        prev_end = spans[idx - 1][1] if (idx is not None and idx > 0) else -1
+        for m in _PRIOR_CUE_RE.finditer(left_cue):
+            ce = base + m.end()
+            if prev_end >= ce:                 # 手がかりと数の間に別の数 → その数のもの
+                continue
+            if _BASELINE_AFTER_CUE_RE.match(s[ce:ce + 6]) or s[ce:ce + 1] == "比":
+                continue                       # 比較の基準 / 前期比
+            period = "Prior1"
+            break
+    # R-2 差の形 / R-3 衝突
+    left, right = s[max(0, a - 8):a], s[b:b + 40]
+    flow = bool(_FLOW_BEFORE_RE.search(left))
+    has_form = bool(_F1_RE.search(left) or _F2_RE.match(right) or _F3_RE.match(right) or _F5_RE.match(right))
+    diff = has_form and not flow and not _inside_prior_paren(s, a)
+    return period, (diff and period == "Current")                  # C-1: 前期なら必ず単一
 
