+# -*- coding: utf-8 -*-
+"""採用条件 T-E1・T-E2(docs/ADOPTION_CONDITIONS_2026-10-13.md §2-1)。
+
+守る対象は ``recipes._assign_period_form``(割当の純粋関数)と、その結果を使う
+``recipes._direct_value_claim`` の期間の選び方。
+
+**封 EXTRACTION_SEAL_V2_2026-10-12 §2.1 の表はここに書かない。** 表は
+``test_extraction_v2.py`` が持つ(封じた表と、監査が名指しした境界の追加を混ぜない)。
+ここに並べるのは、監査 `EXTRACTION_V2_AUDIT_RESULT_2026-10-13` §6 で
+**試験が黙った変異 6 本**が通してしまう入力。期待値は**封 §2 の規則の字から導いた**もので、
+実装の出力を写したものではない(導いた期待値と実装が食い違えば、この試験は赤くなる)。
+
+fact と context は合成で、追跡されていない ZIP も Golden 期待値も読まない。
+"""
+
+import unittest
+
+from adapters.xbrl import extract as E
+from adapters.xbrl import recipes as R
+
+CUR = "CurrentYearDuration"
+PRI = "Prior1YearDuration"
+CONTEXTS = {CUR: {"start": "2025-07-01", "end": "2026-06-30"},
+            PRI: {"start": "2024-07-01", "end": "2025-06-30"}}
+
+# 手がかり「前期」の終わり(index 2)から数の開始までの字数を 13 / 14 にする詰め物。
+_FILL13 = "の業績につきまして、ああい"
+_FILL14 = "の業績につきまして、ああいう"
+assert len(_FILL13) == 13 and len(_FILL14) == 14
+
+# (名前, 印つきの文, 期間, 対か, 封のどの字から導いたか, この行が赤にする変異)
+ROWS = [
+    ("数+増加額", "差引【1,012百万円】の増加額となりました。", "Current", False,
+     "F2 の増減語は 増加額・減少額 を含まない(§2 R-2 F1 の括弧書き)", "M-E1a"),
+    ("数+減価償却費", "うち【452百万円】の減価償却費が含まれます。", "Current", False,
+     "F2 の裸の 増・減 は後ろに漢字が続かないときだけ(§2 R-2 F2)", "M-E1b"),
+    ("数+(%)増加", "売上総利益は【684百万円】(5.7%)の減少となりました。", "Current", False,
+     "F3 は括弧の中に % が無いときだけ(§2 R-2 F3)", "M-E1c"),
+    ("増加額+数+増減語", "売上債権の増加額【802百万円】増加しました。", "Current", False,
+     "R-2f 流れの項目は差ではなく単一(§2 R-2 R-2f)", "M-E1d"),
+    ("前期に比べ+数のみ", "前期に比べ【42,487千円】", "Current", True,
+     "R-1.2 の手がかりの直後が に比べ なら比較の基準で期間に使わない + F1", "M-E1e"),
+    ("手がかり 15 字", "前期" + _FILL13 + "【510百万円】です。", "Prior1", False,
+     "R-1.2 数の直前 15 字に手がかり(窓の内側)", "M-E1f"),
+    ("手がかり 16 字", "前期" + _FILL14 + "【510百万円】です。", "Current", False,
+     "R-1.2 数の直前 15 字に手がかりが無い(窓の外側)", "M-E1f"),
+]
+
+# T-E2 の摂動に使う文(上の行 + 前期の括弧・対の形)。
+EXTRA_SENTENCES = [
+    "売上高は【100百万円】となりました。",
+    "売上高の増加【6百万円】です。",
+    "経常利益は1,457百万円(前期【2,709百万円】)となりました。",
+]
+
+
+def unmark(marked):
+    a = marked.index("【")
+    b = marked.index("】")
+    return marked[:a] + marked[a + 1:b] + marked[b + 1:], a, b - 1
+
+
+def fact(name, context, value):
+    return {"name": name, "context": context, "value": float(value), "unit": "JPY", "decimals": "-3"}
+
+
+def bend_digits(s):
+    """数の字だけを別の字に替える(桁数は変えない)。"""
+
+    return "".join((str((int(ch) % 9) + 1) if ch.isdigit() else ch) for ch in s)
+
+
+def run_claim(marked, num, elems, facts, unit="百万円"):
+    s, a, b = unmark(marked)
+    claim = {"id": "SYN", "value": num}
+    R._direct_value_claim(claim, s, a, b, 1, num, unit, None, "主語", elems, None, facts, CONTEXTS)
+    return claim
+
+
+class TE1Boundary(unittest.TestCase):
+    """T-E1 監査が名指しした境界。期待値は封 §2 の字から導いた。"""
+
+    def test_each_boundary_row(self):
+        for name, marked, period, pair, why, mutation in ROWS:
+            s, a, b = unmark(marked)
+            self.assertTrue(any(x == a and y == b for (x, y, _v, _u, _p) in E.iter_numbers(s)),
+                            "%s: 印の位置が iter_numbers の数と一致しない" % name)
+            self.assertEqual(R._assign_period_form(s, a, b), (period, pair),
+                             "%s(%s / %s を赤にする行)" % (name, why, mutation))
+
+    def test_the_cue_window_rows_differ_by_exactly_one_character(self):
+        # 15 字 / 16 字の 2 行が、窓の境界そのものを見ていることを留める。
+        inside = [r for r in ROWS if r[0] == "手がかり 15 字"][0]
+        outside = [r for r in ROWS if r[0] == "手がかり 16 字"][0]
+        _s_in, a_in, _b_in = unmark(inside[1])
+        _s_out, a_out, _b_out = unmark(outside[1])
+        self.assertEqual((a_in - 2, a_out - 2), (13, 14))
+        self.assertEqual((inside[2], outside[2]), ("Prior1", "Current"))
+
+
+class TE2AssignmentIgnoresValues(unittest.TestCase):
+    """T-E2 割当と pointer は値で変わらない(封 §2 R-4・§6)。"""
+
+    def test_bending_the_digits_does_not_move_the_assignment(self):
+        for marked in [r[1] for r in ROWS] + EXTRA_SENTENCES:
+            s, a, b = unmark(marked)
+            base = R._assign_period_form(s, a, b)
+            spans = [(x, y) for (x, y, _v, _u, _p) in E.iter_numbers(s)]
+            bent = bend_digits(s)
+            self.assertEqual([(x, y) for (x, y, _v, _u, _p) in E.iter_numbers(bent)], spans,
+                             "数の位置が動いた(摂動の作り方が悪い): %s" % marked)
+            self.assertEqual(R._assign_period_form(bent, a, b), base, marked)
+
+    def test_the_pointer_does_not_move_when_the_claim_value_changes(self):
+        facts = [fact("jppfs_cor:NetSales", CUR, 100e6)]
+        seen = set()
+        for num in (94, 100, 120):
+            claim = run_claim("売上高は【%d百万円】となりました。" % num, num, ["NetSales"], facts)
+            seen.add(claim.get("pointer"))
+        self.assertEqual(seen, {"xbrl:jppfs_cor:NetSales@" + CUR})
+
+    def test_the_pointer_does_not_move_when_the_fact_value_changes(self):
+        seen = set()
+        for v in (100e6, 94e6, -3.0):
+            claim = run_claim("売上高は【100百万円】となりました。", 100, ["NetSales"],
+                              [fact("jppfs_cor:NetSales", CUR, v)])
+            seen.add(claim.get("pointer"))
+        self.assertEqual(seen, {"xbrl:jppfs_cor:NetSales@" + CUR})
+
+    def test_a_value_that_does_not_match_is_not_looked_for_in_another_period(self):
+        # 封 BINDING_ORDER_SEAL §3 規則 3(値による再探索の禁止)。
+        # 当期の fact は一致せず、前期の fact が一致する入力。
+        facts = [fact("jppfs_cor:NetSales", CUR, 100e6),
+                 fact("jppfs_cor:NetSales", PRI, 94e6)]
+        claim = run_claim("売上高は【94百万円】となりました。", 94, ["NetSales"], facts)
+        self.assertEqual(claim.get("pointer"), "xbrl:jppfs_cor:NetSales@" + CUR)
+        self.assertEqual(claim.get("result"), "VALUE_MISMATCH")
+
+
+if __name__ == "__main__":
+    unittest.main()
