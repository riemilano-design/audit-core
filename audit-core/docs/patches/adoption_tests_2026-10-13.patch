+# -*- coding: utf-8 -*-
+"""採用条件 T-R5(docs/ADOPTION_CONDITIONS_2026-10-13.md §1-1)と、
+T-R1・T-R2・T-R4・T-E1・T-E2 が**実際に欠陥を検知する**ことの実証。
+
+**なぜ専用のハーネスか。** 既存の ``test_mutations.py`` は部分木で
+``unittest discover`` を走らせ、終了コードで赤/緑を判定する。2 本の patch を
+重ねた木は**変異を当てる前から 13 本落ちている**ため、どの変異も rc=1 =「赤」に
+見える(飽和)。台帳 L-021 に記録したとおり、接頭辞を取り違える変異はエンジンの
+出力を 28 行変えるのに、既存の試験の数は 1 本も動かなかった。
+
+そこでこのハーネスは、部分木に**この条件のための試験ファイルだけ**を置く
+(ZIP も Golden 期待値も読まないので、基準が緑になる)。
+
+**「検知した」と「実行が失敗しただけ」を分ける。** 変異を当てた回は、次の
+4 つを別々に見て全部満たしたときだけ検知とする。
+  1. ``Ran N tests`` の組が**ちょうど 1 組**で、N が基準と同じ(収集が落ちていない)。
+  2. ``errors`` が 0(import やハーネスの壊れではなく、assert の失敗)。
+  3. 落ちた試験の**名前**が、その変異に対応する名前を含む(**件数では数えない**)。
+  4. 終了コードが 0 でない。
+``grep -c "^FAIL:"`` のような行数の合算は使わない。
+"""
+
+import hashlib
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_AUDIT_CORE_DIR = os.path.abspath(os.path.join(_HERE, "..", "..", ".."))
+_ADAPTERS_SRC_DIR = os.path.join(_AUDIT_CORE_DIR, "adapters")
+_CORE_PY_DIR = os.path.join(_AUDIT_CORE_DIR, "core", "py")
+_TESTS_DIR = os.path.join(_AUDIT_CORE_DIR, "tests")
+_TARGET = os.path.join("adapters", "xbrl", "recipes.py")
+
+# この条件のための試験ファイル(部分木に置くのはこれだけ)
+_GUARD_TEST_FILENAMES = ("test_representative_selection.py", "test_extraction_v2_boundary.py")
+
+_RAN_RE = re.compile(r"^Ran (\d+) tests? in ", re.M)
+_FAILED_RE = re.compile(r"^FAILED \((.*)\)\s*$", re.M)
+_OK_RE = re.compile(r"^OK\s*$", re.M)
+_FAILNAME_RE = re.compile(r"^(FAIL|ERROR): (\S+) \(", re.M)
+
+# T-R5 が名指しした 2 つ(接頭辞の取り違え・最終順序)+ 取りこぼしを見る 3 つ
+# + T-E1 の 6 本 + T-E2 の 1 本。old は recipes.py の中で 1 回だけ現れる字。
+_MUTATIONS = [
+    {"id": "M-R1-prefix-swapped", "条件": "T-R1・T-R2",
+     "old": 'startswith("jppfs_cor:")', "new": 'startswith("jpcrp_cor:")',
+     "expect": {"test_exactly_one_jppfs_kind_wins_even_when_it_is_not_the_head",
+                "test_no_jppfs_kind_returns_the_head_in_document_order"},
+     "note": "台帳 L-021 の変異①と同じ置換。既存の試験では黙った。"},
+    {"id": "M-R2-representative-is-the-tail", "条件": "T-R1",
+     "old": "        return group[0]\n", "new": "        return group[-1]\n",
+     "expect": {"test_no_jppfs_kind_returns_the_head_in_document_order"},
+     "note": "代表の最終順序(T-R5 の名指し)。"},
+    {"id": "M-R3-one-kind-becomes-at-least-one", "条件": "T-R1・T-R2",
+     "old": "    if len(names) == 1:", "new": "    if len(names) >= 1:",
+     "expect": {"test_two_jppfs_kinds_decide_nothing", "test_three_jppfs_kinds_decide_nothing"},
+     "note": "2 種以上でも代表を決めてしまう。"},
+    {"id": "M-R4-never-returns-none",
+     "条件": "T-R1・T-R2",
+     "old": '    if len(names) == 1:\n        return next(f for f in group if f["name"] == names[0])\n    return None',
+     "new": '    if len(names) == 1:\n        return next(f for f in group if f["name"] == names[0])\n    return group[0]',
+     "expect": {"test_two_jppfs_kinds_decide_nothing", "test_three_jppfs_kinds_decide_nothing"},
+     "note": "代表を決めない枝を潰す(停止の取りこぼし)。"},
+    {"id": "M-R5-groups-chosen-by-value", "条件": "T-R4",
+     "old": "    groups = _collapse_candidates(pool)",
+     "new": "    groups = [[f for f in pool if V.match_value(f[\"value\"], target, scale)] or list(pool)]",
+     "expect": {"test_several_groups_stop_even_when_one_of_them_matches_the_claim"},
+     "note": "候補の群を値で選ぶ(封 BINDING_ORDER_SEAL §3 規則 4 の違反)。"},
+    {"id": "M-E1a-diff-word-includes-zougakugaku", "条件": "T-E1",
+     "old": 'r"(?:(?:増加|減少)(?!額)|', "new": 'r"(?:(?:増加|減少)(?:額)?|',
+     "expect": {"test_each_boundary_row"}, "note": "増加額・減少額を増減語に含める。"},
+    {"id": "M-E1b-bare-word-ignores-following-kanji", "条件": "T-E1",
+     "old": 'r"[増減](?![一-龥])"', "new": 'r"[増減]"',
+     "expect": {"test_each_boundary_row"}, "note": "減価・減損を増減語として拾う。"},
+    {"id": "M-E1c-f3-allows-percent", "条件": "T-E1",
+     "old": 'r"^[(（][^()（）%％]*[)）]の?"', "new": 'r"^[(（][^()（）]*[)）]の?"',
+     "expect": {"test_each_boundary_row"}, "note": "F3 の括弧の中に % があっても対にする。"},
+    {"id": "M-E1d-flow-item-rule-removed", "条件": "T-E1",
+     "old": "    flow = bool(_FLOW_BEFORE_RE.search(left))",
+     "new": "    flow = False",
+     "expect": {"test_each_boundary_row"}, "note": "R-2f(増加額・減少額の直前)を外す。"},
+    {"id": "M-E1e-baseline-cue-not-excluded", "条件": "T-E1",
+     "old": "            if _BASELINE_AFTER_CUE_RE.match(s[ce:ce + 6]) or s[ce:ce + 1] == \"比\":",
+     "new": "            if False:",
+     "expect": {"test_each_boundary_row"}, "note": "前期に比べ・前期比 を期間の手がかりに使う。"},
+    {"id": "M-E1f-cue-window-widened", "条件": "T-E1",
+     "old": "        base = max(0, a - 15)", "new": "        base = max(0, a - 25)",
+     "expect": {"test_each_boundary_row"},
+     "note": ("手がかりの窓 15 字 → 25 字(旧窓)。"
+              "test_the_cue_window_rows_differ_by_exactly_one_character は表の宣言と"
+              "印の位置だけを見るので、この変異を**構造的に検知できない**(期待に入れない)。")},
+    {"id": "M-E2-period-searched-again-by-value", "条件": "T-E2",
+     "old": '    want_single = "Prior1Year" if period == "Prior1" else "CurrentYear"',
+     "new": ('    want_single = "Prior1Year" if (period == "Prior1" or not any(\n'
+             '        V.match_value(f["value"], target, scale) for f in facts\n'
+             '        if f["context"].startswith("CurrentYear"))) else "CurrentYear"'),
+     "expect": {"test_a_value_that_does_not_match_is_not_looked_for_in_another_period"},
+     "note": "値が合わないときに別の期間を探す(封 BINDING_ORDER_SEAL §3 規則 3 の違反)。"},
+]
+
+# 陰性対照: 同じファイルのコメントだけを変える(振る舞いは変わらない)。
+_NEGATIVE_CONTROL = {
+    "id": "N-C-comment-only",
+    "old": "# 正本は fixtures/xbrl/premeasure_assign_2026-10-12.py の v2_rule。",
+    "new": "# 正本は fixtures/xbrl/premeasure_assign_2026-10-12.py の v2_rule(陰性対照)。",
+}
+
+
+def _sha256(path):
+    with open(path, "rb") as handle:
+        return hashlib.sha256(handle.read()).hexdigest()
+
+
+def _build_tree(temp_root):
+    shutil.copytree(_CORE_PY_DIR, os.path.join(temp_root, "core", "py"))
+    shutil.copytree(_ADAPTERS_SRC_DIR, os.path.join(temp_root, "adapters"))
+    tests_dir = os.path.join(temp_root, "tests")
+    os.makedirs(tests_dir)
+    shutil.copyfile(os.path.join(_TESTS_DIR, "__init__.py"), os.path.join(tests_dir, "__init__.py"))
+    adapters_dir = os.path.join(tests_dir, "adapters")
+    os.makedirs(adapters_dir)
+    shutil.copyfile(os.path.join(_TESTS_DIR, "adapters", "__init__.py"),
+                    os.path.join(adapters_dir, "__init__.py"))
+    xbrl_dir = os.path.join(adapters_dir, "xbrl")
+    os.makedirs(xbrl_dir)
+    shutil.copyfile(os.path.join(_HERE, "__init__.py"), os.path.join(xbrl_dir, "__init__.py"))
+    for name in _GUARD_TEST_FILENAMES:
+        shutil.copyfile(os.path.join(_HERE, name), os.path.join(xbrl_dir, name))
+
+
+def _run(temp_root):
+    # 変異と原文が**同じ字数**だと、mtime の分解能(1 秒)では pyc が古いまま
+    # 使われて変異が隠れる(M-R1・M-R3・M-E1f は置換前後で字数が同じ)。
+    # 実行ごとに捨てて、必ず作り直させる。
+    pycache = os.path.join(temp_root, "pyc")
+    shutil.rmtree(pycache, ignore_errors=True)
+    completed = subprocess.run(
+        [sys.executable, "-X", "pycache_prefix=" + pycache,
+         "-m", "unittest", "discover", "-s", "tests", "-t", "."],
+        cwd=temp_root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+    text = completed.stdout.decode("utf-8", errors="replace")
+    ran = _RAN_RE.findall(text)
+    failed = _FAILED_RE.findall(text)
+    counts = {"failures": 0, "errors": 0}
+    if failed:
+        for part in failed[-1].split(","):
+            key, _sep, value = part.strip().partition("=")
+            if key in counts:
+                counts[key] = int(value)
+    return {
+        "rc": completed.returncode,
+        "ran_blocks": [int(n) for n in ran],
+        "ok": bool(_OK_RE.search(text)),
+        "failed_line": failed[-1] if failed else None,
+        "counts": counts,
+        "names": sorted({m[1] for m in _FAILNAME_RE.findall(text)}),
+        "tail": text[-1500:],
+    }
+
+
+def _apply(temp_root, mutation):
+    path = os.path.join(temp_root, _TARGET)
+    with open(path, "r", encoding="utf-8") as handle:
+        text = handle.read()
+    occurrences = text.count(mutation["old"])
+    if occurrences != 1:
+        raise AssertionError("%s: old が %d 回現れる(1 回でなければならない)"
+                             % (mutation["id"], occurrences))
+    with open(path, "w", encoding="utf-8") as handle:
+        handle.write(text.replace(mutation["old"], mutation["new"], 1))
+
+
+def _restore(temp_root, original_text):
+    """**置換で戻さない。**保存した原文を書き戻す(逆向きの置換は別の場所に当たる)。"""
+
+    with open(os.path.join(temp_root, _TARGET), "w", encoding="utf-8") as handle:
+        handle.write(original_text)
+
+
+class AdoptionMutationGate(unittest.TestCase):
+    """基準 → 変異 → 陰性対照 → 復元 の 4 段階を、1 つの部分木で順に走らせる。"""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.temp_root = tempfile.mkdtemp(prefix="audit-core-adoption-gate-")
+        _build_tree(cls.temp_root)
+        cls.target_path = os.path.join(cls.temp_root, _TARGET)
+        with open(cls.target_path, "r", encoding="utf-8") as handle:
+            cls.original_text = handle.read()
+        cls.base_sha = _sha256(cls.target_path)
+        cls.baseline = _run(cls.temp_root)
+
+    @classmethod
+    def tearDownClass(cls):
+        shutil.rmtree(cls.temp_root, ignore_errors=True)
+
+    def _assert_green(self, result, label):
+        self.assertEqual(result["ran_blocks"], [self.baseline["ran_blocks"][0]],
+                         "%s: Ran の組が 1 組でないか本数が違う %r" % (label, result["ran_blocks"]))
+        self.assertTrue(result["ok"], "%s: OK でない(%s)\n%s" % (label, result["failed_line"], result["tail"]))
+        self.assertEqual(result["rc"], 0, "%s: rc=%d" % (label, result["rc"]))
+        self.assertEqual(result["names"], [], "%s: 落ちた試験 %r" % (label, result["names"]))
+
+    def test_1_baseline_is_green(self):
+        self.assertEqual(len(self.baseline["ran_blocks"]), 1,
+                         "基準: Ran の組が 1 組でない %r(入れ子の実行が混ざっている)"
+                         % (self.baseline["ran_blocks"],))
+        self.assertGreater(self.baseline["ran_blocks"][0], 0)
+        self._assert_green(self.baseline, "基準")
+
+    def test_2_negative_control_does_not_turn_anything_red(self):
+        _apply(self.temp_root, _NEGATIVE_CONTROL)
+        try:
+            self._assert_green(_run(self.temp_root), "陰性対照(コメントだけ)")
+        finally:
+            _restore(self.temp_root, self.original_text)
+            self.assertEqual(_sha256(self.target_path), self.base_sha, "陰性対照の復元に失敗")
+
+    def test_3_every_mutation_is_detected_by_name_then_restored(self):
+        failures = []
+        for mutation in _MUTATIONS:
+            _apply(self.temp_root, mutation)
+            try:
+                result = _run(self.temp_root)
+            finally:
+                _restore(self.temp_root, self.original_text)
+            restored_sha = _sha256(self.target_path)
+            after = _run(self.temp_root)
+
+            why = []
+            if len(result["ran_blocks"]) != 1:
+                why.append("Ran の組が %r(1 組でない)" % (result["ran_blocks"],))
+            elif result["ran_blocks"][0] != self.baseline["ran_blocks"][0]:
+                why.append("収集された本数が %d(基準 %d)"
+                           % (result["ran_blocks"][0], self.baseline["ran_blocks"][0]))
+            if result["counts"]["errors"] != 0:
+                why.append("errors=%d(assert の失敗でない)" % result["counts"]["errors"])
+            if result["rc"] == 0:
+                why.append("rc=0(黙った)")
+            missing = sorted(mutation["expect"] - set(result["names"]))
+            if missing:
+                why.append("期待した名前が落ちていない %r / 実際に落ちた名前 %r"
+                           % (missing, result["names"]))
+            if restored_sha != self.base_sha:
+                why.append("復元後の sha が基準と違う")
+            if not after["ok"] or after["rc"] != 0:
+                why.append("復元後に緑に戻らない(%s)" % after["failed_line"])
+            if why:
+                failures.append("%s: %s" % (mutation["id"], " / ".join(why)))
+        self.assertEqual(failures, [], "変異の検知に失敗:\n" + "\n".join(failures))
+
+    def test_4_every_mutation_names_a_condition_and_a_test_that_exists(self):
+        import importlib
+        known = set()
+        for name in _GUARD_TEST_FILENAMES:
+            module = importlib.import_module("tests.adapters.xbrl." + name[:-3])
+            for attr in vars(module).values():
+                if isinstance(attr, type) and issubclass(attr, unittest.TestCase):
+                    known |= {n for n in dir(attr) if n.startswith("test_")}
+        for mutation in _MUTATIONS:
+            self.assertTrue(mutation["expect"], mutation["id"])
+            self.assertTrue(mutation["条件"], mutation["id"])
+            self.assertEqual(sorted(mutation["expect"] - known), [],
+                             "%s: 存在しない試験名を期待している" % mutation["id"])
+
+
+if __name__ == "__main__":
+    unittest.main()
