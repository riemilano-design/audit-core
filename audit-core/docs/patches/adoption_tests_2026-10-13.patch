+# -*- coding: utf-8 -*-
+"""採用条件 T-R1・T-R2・T-R4(docs/ADOPTION_CONDITIONS_2026-10-13.md §1-1)。
+
+守る対象は ``recipes._representative`` と ``recipes._collapse_candidates``、および
+``recipes._direct_value_claim`` の 3 つの呼び出し(単一・対の a 側・対の b 側)。
+
+fact と context は**合成**で、追跡されていない ZIP も Golden 期待値も読まない。
+これは T-R5 の変異ハーネスが、基準が緑の状態でこのファイルだけを走らせるため。
+
+``ambiguous_count`` は**立っていること**だけを見て、値は固定しない。
+値の意味は T-R6(未決。封 CANDIDATE_DEFINITION_SEAL §5 は「畳んだ後の候補数」と
+定めるが、``_representative`` が None を返す枝は封が扱っていない)。
+"""
+
+import unittest
+
+from adapters.xbrl import extract as E
+from adapters.xbrl import recipes as R
+
+CUR = "CurrentYearDuration"
+PRI = "Prior1YearDuration"
+CONTEXTS = {CUR: {"start": "2025-07-01", "end": "2026-06-30"},
+            PRI: {"start": "2024-07-01", "end": "2025-06-30"}}
+
+
+def fact(name, context, value):
+    return {"name": name, "context": context, "value": float(value), "unit": "JPY", "decimals": "-3"}
+
+
+def unmark(marked):
+    a = marked.index("【")
+    b = marked.index("】")
+    return marked[:a] + marked[a + 1:b] + marked[b + 1:], a, b - 1
+
+
+def run_claim(marked, num, elems, facts, unit="百万円"):
+    """``_direct_value_claim`` を 1 回だけ呼び、claim の辞書を返す。"""
+
+    s, a, b = unmark(marked)
+    assert any(x == a and y == b for (x, y, _v, _u, _p) in E.iter_numbers(s)), marked
+    claim = {"id": "SYN", "value": num}
+    R._direct_value_claim(claim, s, a, b, 1, num, unit, None, "主語", elems, None, facts, CONTEXTS)
+    return claim
+
+
+class TR1Representative(unittest.TestCase):
+    """T-R1 ``_representative`` の返り値を入力ごとに固定する。"""
+
+    def test_no_jppfs_kind_returns_the_head_in_document_order(self):
+        # 群は 2 件。先頭と末尾が別名なので、代表を末尾に差し替える変異が赤くなる。
+        group = [fact("jpcrp_cor:AlphaSummaryOfBusinessResults", CUR, 100e6),
+                 fact("jpcrp_cor:BetaSummaryOfBusinessResults", CUR, 100e6)]
+        chosen = R._representative(group)
+        self.assertIsNotNone(chosen, "jppfs が 0 種なら文書順の先頭を返す")
+        self.assertEqual(chosen["name"], "jpcrp_cor:AlphaSummaryOfBusinessResults")
+
+    def test_exactly_one_jppfs_kind_wins_even_when_it_is_not_the_head(self):
+        group = [fact("jpcrp_cor:AlphaSummaryOfBusinessResults", CUR, 100e6),
+                 fact("jppfs_cor:Alpha", CUR, 100e6)]
+        chosen = R._representative(group)
+        self.assertIsNotNone(chosen, "jppfs が 1 種ならその fact を返す")
+        self.assertEqual(chosen["name"], "jppfs_cor:Alpha")
+
+    def test_two_jppfs_kinds_decide_nothing(self):
+        group = [fact("jppfs_cor:Alpha", CUR, 100e6),
+                 fact("jppfs_cor:AlphaSummaryOfBusinessResults", CUR, 100e6)]
+        self.assertIsNone(R._representative(group))
+
+    def test_three_jppfs_kinds_decide_nothing(self):
+        group = [fact("jppfs_cor:Alpha", CUR, 100e6),
+                 fact("jppfs_cor:Beta", CUR, 100e6),
+                 fact("jppfs_cor:Gamma", CUR, 100e6)]
+        self.assertIsNone(R._representative(group))
+
+    def test_same_jppfs_name_in_several_facts_takes_the_first_in_document_order(self):
+        first = fact("jppfs_cor:Alpha", CUR, 100e6)
+        first["decimals"] = "-3"
+        second = fact("jppfs_cor:Alpha", CUR, 100e6)
+        second["decimals"] = "-6"
+        group = [fact("jpcrp_cor:AlphaSummaryOfBusinessResults", CUR, 100e6), first, second]
+        chosen = R._representative(group)
+        self.assertIsNotNone(chosen)
+        self.assertEqual(chosen["name"], "jppfs_cor:Alpha")
+        self.assertIs(chosen, first)
+
+
+class TR2AllThreeCallSitesStop(unittest.TestCase):
+    """T-R2 単一・対の a 側・対の b 側の 3 呼び出しで、jppfs 2 種なら停止する。
+
+    片側だけに規約を当てた実装(取りこぼし)は、対の b 側の試験で赤くなる。
+    """
+
+    SINGLE = "売上高は【100百万円】となりました。"
+    PAIR = "売上高の増加【6百万円】です。"
+
+    def assert_stopped(self, claim):
+        self.assertEqual(claim.get("reason"), "ambiguous(elements)")
+        self.assertIsNotNone(claim.get("ambiguous_count"), "ambiguous_count が立っていない")
+        self.assertNotIn("pointer", claim)
+        self.assertFalse(claim.get("bound"))
+        self.assertIsNone(claim.get("result"))
+
+    def test_single_path_stops(self):
+        facts = [fact("jppfs_cor:NetSales", CUR, 100e6),
+                 fact("jppfs_cor:NetSalesSummaryOfBusinessResults", CUR, 100e6)]
+        self.assert_stopped(run_claim(self.SINGLE, 100, ["NetSales"], facts))
+
+    def test_pair_path_stops_when_only_the_a_side_is_ambiguous(self):
+        facts = [fact("jppfs_cor:NetSales", CUR, 100e6),
+                 fact("jppfs_cor:NetSalesSummaryOfBusinessResults", CUR, 100e6),
+                 fact("jppfs_cor:NetSales", PRI, 94e6)]
+        self.assert_stopped(run_claim(self.PAIR, 6, ["NetSales"], facts))
+
+    def test_pair_path_stops_when_only_the_b_side_is_ambiguous(self):
+        facts = [fact("jppfs_cor:NetSales", CUR, 100e6),
+                 fact("jppfs_cor:NetSales", PRI, 94e6),
+                 fact("jppfs_cor:NetSalesSummaryOfBusinessResults", PRI, 94e6)]
+        self.assert_stopped(run_claim(self.PAIR, 6, ["NetSales"], facts))
+
+    def test_the_pair_sentence_really_takes_the_pair_path(self):
+        # 上の 2 本が「対の経路を通っていない」ために通ることを防ぐ。
+        facts = [fact("jppfs_cor:NetSales", CUR, 100e6),
+                 fact("jppfs_cor:NetSales", PRI, 94e6)]
+        claim = run_claim(self.PAIR, 6, ["NetSales"], facts)
+        self.assertEqual(claim.get("form"), "derived_value")
+        self.assertEqual((claim.get("pointer") or [None])[-1], "formula:a-b")
+
+    def test_the_single_sentence_really_takes_the_single_path(self):
+        facts = [fact("jppfs_cor:NetSales", CUR, 100e6)]
+        claim = run_claim(self.SINGLE, 100, ["NetSales"], facts)
+        self.assertEqual(claim.get("pointer"), "xbrl:jppfs_cor:NetSales@" + CUR)
+
+
+class TR4SelectionDoesNotUseValues(unittest.TestCase):
+    """T-R4 群が複数ある入力で、値だけを変えても選択が変わらない。
+
+    封 BINDING_ORDER_SEAL §3 の規則 4(候補が複数なら値を使わずに停止)。
+    """
+
+    SINGLE = "売上高は【100百万円】となりました。"
+
+    def test_representative_ignores_the_value_of_the_group(self):
+        names = ("jpcrp_cor:AlphaSummaryOfBusinessResults", "jppfs_cor:Alpha")
+        chosen = set()
+        for v in (100e6, 1.0, -7777.0, 0.0):
+            picked = R._representative([fact(names[0], CUR, v), fact(names[1], CUR, v)])
+            self.assertIsNotNone(picked, "値 %r で代表が決まらなかった" % v)
+            chosen.add(picked["name"])
+        self.assertEqual(chosen, {"jppfs_cor:Alpha"})
+
+    def test_several_groups_stop_even_when_one_of_them_matches_the_claim(self):
+        facts = [fact("jppfs_cor:NetSales", CUR, 100e6),
+                 fact("jppfs_cor:NetSalesSummaryOfBusinessResults", CUR, 120e6)]
+        for num in (100, 120, 999):
+            claim = run_claim(self.SINGLE.replace("100百万円", "%d百万円" % num), num, ["NetSales"], facts)
+            self.assertEqual(claim.get("reason"), "ambiguous(elements)",
+                             "num=%d で停止しなかった(値で候補を選んでいる)" % num)
+            self.assertNotIn("pointer", claim)
+
+    def test_the_same_two_groups_bind_nothing_whatever_the_fact_values_are(self):
+        for a_value, b_value in ((100e6, 120e6), (120e6, 100e6), (1.0, 2.0)):
+            facts = [fact("jppfs_cor:NetSales", CUR, a_value),
+                     fact("jppfs_cor:NetSalesSummaryOfBusinessResults", CUR, b_value)]
+            claim = run_claim(self.SINGLE, 100, ["NetSales"], facts)
+            self.assertEqual(claim.get("reason"), "ambiguous(elements)")
+
+
+if __name__ == "__main__":
+    unittest.main()
