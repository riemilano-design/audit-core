{
 "読込みの版": "r1",
 "素材": "SQLite の file 1 つ(Charles River Accounting Dataset v2027.1)。読むだけ",
 "表": {
  "元帳": {
   "表": "GLEntry",
   "列": {
    "行の番号": "GLEntryID",
    "日付": "PostingDate",
    "科目": "AccountID",
    "借方": "Debit",
    "貸方": "Credit",
    "伝票の種類": "VoucherType",
    "元の書類の番号": "SourceDocumentID"
   }
  },
  "科目": {
   "表": "Account",
   "列": {
    "鍵": "AccountID",
    "科目番号": "AccountNumber",
    "大分類": "AccountType",
    "小分類": "AccountSubType"
   }
  },
  "振替伝票": {
   "表": "JournalEntry",
   "列": {
    "鍵": "JournalEntryID",
    "仕訳の種類": "EntryType"
   }
  }
 },
 "結び方": {
  "元帳と科目": "元帳の「科目」と科目の「鍵」が同じ行を結ぶ(結ばれない元帳の行は共通の表に入れない)",
  "元帳と振替伝票": "元帳の「伝票の種類」が「振替伝票の字」と同じで、元帳の「元の書類の番号」が振替伝票の「鍵」と同じ時だけ結ぶ。結ばれない行の「仕訳の種類」は空",
  "振替伝票の字": "JournalEntry"
 },
 "共通の表": "仕訳の行",
 "列": [
  {
   "名": "行の番号",
   "出どころ": "元帳の「行の番号」",
   "型": "整数"
  },
  {
   "名": "日付",
   "出どころ": "元帳の「日付」",
   "型": "字 YYYY-MM-DD"
  },
  {
   "名": "科目番号",
   "出どころ": "科目の「科目番号」",
   "型": "整数"
  },
  {
   "名": "科目の大分類",
   "出どころ": "科目の「大分類」",
   "型": "字"
  },
  {
   "名": "科目の小分類",
   "出どころ": "科目の「小分類」",
   "型": "字"
  },
  {
   "名": "伝票の種類",
   "出どころ": "元帳の「伝票の種類」",
   "型": "字"
  },
  {
   "名": "仕訳の種類",
   "出どころ": "振替伝票の「仕訳の種類」(結ばれない行は空)",
   "型": "字か空"
  },
  {
   "名": "借方",
   "出どころ": "元帳の「借方」",
   "型": "額"
  },
  {
   "名": "貸方",
   "出どころ": "元帳の「貸方」",
   "型": "額"
  }
 ],
 "額": {
  "単位": "最小の通貨の単位",
  "丸め": "行ごとに借方・貸方を 100 倍して最も近い整数へ丸め(半分は 0 から遠い方へ)、整数で足す。浮動小数のまま足さない",
  "材料の数値": "和を 100 で割った小数 2 桁ちょうどの字"
 }
}