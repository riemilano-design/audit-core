 "claims": [
  {
   "id": "K-001",
   "text": "片山さつき財務大臣は、令和八年四月一日から四月十一日までの期間の暫定予算を編成したとし、一般会計暫定予算の歳出総額は八兆五千六百四十一億円、歳入総額は六百四十四億円になると説明した。",
   "speech_order": 2,
   "speaker": "片山さつき",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED",
    "number": "GROUNDED"
   }
  },
  {
   "id": "K-002",
   "text": "片山さつき財務大臣は、暫定予算に新規施策を計上した過去の例として、平成二十五年度の福島定住緊急支援交付金三十億円などを挙げた。",
   "speech_order": 8,
   "speaker": "片山さつき",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED",
    "number": "GROUNDED"
   }
  },
  {
   "id": "K-003",
   "text": "高市早苗総理は、直近三回の暫定予算編成時の閣議における財務大臣の発言に「不測の事態に備えて」という表現が含まれていない理由については承知していないと答えた。",
   "speech_order": 12,
   "speaker": "高市早苗",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED"
   }
  },
  {
   "id": "K-004",
   "text": "階猛委員が今回の衆議院での予算審議を前例にしないと言明するよう求めたのに対し、高市早苗総理は国会の運営は国会において決めることだと答えた。",
   "speech_order": 18,
   "speaker": "高市早苗",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED"
   }
  },
  {
   "id": "K-005",
   "text": "高市早苗総理は、日米首脳会談でホルムズ海峡について我が国の法律の範囲内でできることとできないことを伝えたとし、そこには憲法も自衛隊法も含まれると述べた。",
   "speech_order": 30,
   "speaker": "高市早苗",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED"
   }
  },
  {
   "id": "K-006",
   "text": "階猛委員は、円相場が一年八か月ぶりに一ドル百六十円台となったと述べ、円安による物価高を食い止めるため現状〇・七五％の政策金利を引き上げるべきではないかと日本銀行総裁に質した。",
   "speech_order": 35,
   "speaker": "階猛",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED",
    "number": "GROUNDED"
   }
  },
  {
   "id": "K-007",
   "text": "植田和男日本銀行総裁は、金融政策は為替相場を直接コントロールすることを目的としたものではないとしつつ、為替相場の動向の影響を見極めながら適切に金融政策を判断していくと答えた。",
   "speech_order": 36,
   "speaker": "植田和男",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED"
   }
  },
  {
   "id": "K-008",
   "text": "階猛委員は、十年物国債の利回りが二十七年ぶりに二・三八五％となったと述べ、長期金利の上昇を食い止めるためにも金融政策の見直しが必要だと主張した。",
   "speech_order": 39,
   "speaker": "階猛",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED",
    "number": "GROUNDED"
   }
  },
  {
   "id": "K-009",
   "text": "階猛委員は、経産省の大胆な投資促進税制について、平年度の法人税の減収額が四千百億円と見積もられていると指摘し、総務省の点検で評価可能な項目が全てＥ評価だったと述べた。",
   "speech_order": 41,
   "speaker": "階猛",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED",
    "number": "GROUNDED"
   }
  },
  {
   "id": "K-010",
   "text": "片山さつき財務大臣は、大胆な設備投資促進税制について、与党税調の議論の結果、投資下限額が三十五億円以上、中小企業は五億円以上になったと説明した。",
   "speech_order": 42,
   "speaker": "片山さつき",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED",
    "number": "GROUNDED"
   }
  },
  {
   "id": "K-011",
   "text": "伊佐進一委員は、ガソリンが先週リッター百七十七・七円で、国からの支援は四十八・一円だと述べ、予備費を回した一・一兆円で足りるのか見通しを尋ねた。",
   "speech_order": 50,
   "speaker": "伊佐進一",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED",
    "number": "GROUNDED"
   }
  },
  {
   "id": "K-012",
   "text": "赤澤亮正経済産業大臣は、令和七年度予備費を活用して燃料油価格激変緩和基金に七千九百四十八億円を措置し、元々の基金残高と合わせて一兆円超の基金規模を確保していると答えた。",
   "speech_order": 51,
   "speaker": "赤澤亮正",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED",
    "number": "GROUNDED"
   }
  },
  {
   "id": "K-013",
   "text": "伊佐進一委員は、中道・立憲・公明として、ガソリン・軽油・重油で一・八兆円、電気・ガス料金で一・五兆円などを含む全体で四兆円の修正案を出そうとしていると述べた。",
   "speech_order": 52,
   "speaker": "伊佐進一",
   "state": "GROUNDED",
   "checks": {
    "speaker": "GROUNDED",
    "quote": "GROUNDED",
    "number": "GROUNDED"
   }
  },
  {
   "id": "K-014",
   "text": "高市早苗総理は、これ以上の情勢の悪化を防ぐために事態の早期鎮静化が何よりも大切だとし、攻撃の応酬が既に一か月以上続いていると述べた。",
