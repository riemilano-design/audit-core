{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "answer-selection.v0.1",
  "description": "⑤ Answer selection の出力。⑥ の唯一の入力。正本 docs/NEXTGEN_CONNECTION_DESIGN_2026-09-30.md §3.1.3、計画 docs/PLAN_EXIT_SELECT_2026-10-01.md。【採用は機械がしない】道具は検証を通った候補を id で並べるだけで、採用の印を付けるのは司令塔か人間(正本 ⑤ の行)。【数を書かない】id だけ ― 数は ⑥ が packet から引く(途中の編集で数字が変わる道を作らない)。【internal の欄を持たない・additionalProperties: false】人間の決定「内部の自由分析は下流から参照できない」を ⑥ の入口にも掛ける(CLAUDE.md 規則 8 の (3))。【席の数の欄を作らない】一致を証拠にしない(規則 8 の (2))― basis は自由文なので言い換えた一致は機械で捕まらない(計画 §2a に弱点として明記)。検証器は lib/eventSchema.ts(JSON Schema の部分集合。$ref・$defs・maxItems は扱わないので itemRef の形は 5 か所(lead・p1・answers・actions・humanQueue)に展開してある ― 形がそろっていることは試験が見る(s21))。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "customerRef",
    "packetId",
    "runId",
    "runChoiceReason",
    "lead",
    "p1",
    "answers",
    "boards",
    "actions",
    "humanQueue",
    "adoptedBy"
  ],
  "properties": {
    "contract": {
      "const": "answer-selection"
    },
    "schemaVersion": {
      "const": "0.1"
    },
    "customerRef": {
      "type": "string",
      "minLength": 2,
      "pattern": "[A-Za-z0-9]",
      "description": "顧客の符号(実名を書かない)。退化した文字を入口で落とす(2026-10-01 に packet の provenance で踏んだ型)"
    },
    "packetId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "① の packet の封(中身から取る符号)。⑥ はこの符号の packet から数を引く"
    },
    "runId": {
      "type": "string",
      "minLength": 3,
      "pattern": "[A-Za-z0-9]",
      "description": "採った ④ 統合の周。5 人目は 558b8a81-20261001-2(司令塔の判断 2026-10-01)"
    },
    "runChoiceReason": {
      "type": "string",
      "minLength": 10,
      "description": "その周を採った理由の 1 行(司令塔の指示 2026-10-01)。周の選び方の規則は作らない ― 1 件では規則にしないので、理由を 1 件ずつ書き残す"
    },
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemRef", "statementSource"],
      "description": "「ひとことで」の太字 1 文。文そのものは ⑥ が itemRef の指す statement を規則 5 の言い換えに通して組む",
      "properties": {
        "itemRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seatIndex", "hypothesisId"],
          "properties": {
            "seatIndex": { "type": "integer", "minimum": 0 },
            "hypothesisId": { "type": "string", "minLength": 3, "pattern": "[A-Za-z0-9]" }
          }
        },
        "statementSource": {
          "const": "integration.representative"
        }
      }
    },
    "p1": {
      "type": "array",
      "minItems": 3,
      "description": "「ひとことで」の箇条書き。正本の数はちょうど 3 本 ― この検証器に maxItems が無いので、ちょうど 3 本は道具が見る(字で留めた試験つき)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "aggregateIds", "itemRef", "readingRequired"],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^p1\\.[1-3]$"
          },
          "aggregateIds": {
            "type": "array",
            "minItems": 1,
            "description": "packet の aggregates[].id。実在は道具が照合する(S-3)",
            "items": { "type": "string", "minLength": 3, "pattern": "[A-Za-z0-9]" }
          },
          "itemRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seatIndex", "hypothesisId"],
            "properties": {
              "seatIndex": { "type": "integer", "minimum": 0 },
              "hypothesisId": { "type": "string", "minLength": 3, "pattern": "[A-Za-z0-9]" }
            }
          },
          "readingRequired": {
            "type": "boolean",
            "description": "true の行は itemRef の指す行が statement を持たなければ落ちる(読みの無い数だけの行を本編に出さない ― 4 人目の型)"
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "description": "request の問いごとにちょうど 1 行(件数は道具が見る。S-5)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "status", "machineSummary", "itemRefs", "aggregateIds"],
        "properties": {
          "questionId": {
            "type": "string",
            "pattern": "^q[1-9][0-9]*$"
          },
          "status": {
            "enum": ["answered", "partial", "unanswerable"],
            "description": "採用された答えの形。【機械が既定値を入れない】④ の summary を写さない(S-5a)― 2026-10-01 に機械が partial・人間が unanswerable で食い違った実物がある。写せば人間が却下した読みが冊子に出る"
          },
          "machineSummary": {
            "enum": ["answered", "partial", "unanswerable", "mixed", "no_seat"],
            "description": "④ integration.answersByQuestion[].summary をそのまま写す(5 語のまま。3 語に落とさない)。【捨てない理由】2026-10-01 の食い違いは機械と人間の答えが並んで見えたから見つかった ― 写さないと次にずれたとき誰も気づかない(司令塔の指示)。status と揃えてはいけない"
          },
          "itemRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["seatIndex", "hypothesisId"],
              "properties": {
                "seatIndex": { "type": "integer", "minimum": 0 },
                "hypothesisId": { "type": "string", "minLength": 3, "pattern": "[A-Za-z0-9]" }
              }
            }
          },
          "aggregateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 3, "pattern": "[A-Za-z0-9]" }
          },
          "neededObservation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["what", "howToMeasure"],
            "description": "status が partial / unanswerable のとき必須(S-8。必須であることは道具が見る)。【数を含まない】測れていないものの名と測り方だけ",
            "properties": {
              "what": { "type": "string", "minLength": 4 },
              "howToMeasure": { "type": "string", "minLength": 4 }
            }
          }
        }
      }
    },
    "boards": {
      "type": "array",
      "minItems": 2,
      "description": "盤。正本の数はちょうど 2 つ(ちょうど 2 つは道具が見る)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "gameId", "ply", "packetRef"],
        "properties": {
          "slot": { "type": "string", "pattern": "^p2\\.[12]$" },
          "gameId": { "type": "string", "minLength": 2, "pattern": "[A-Za-z0-9]" },
          "ply": { "type": "integer", "minimum": 1 },
          "packetRef": {
            "type": "string",
            "minLength": 10,
            "description": "facts.engine の中の場所(文法は lib/packetRef.ts)。候補に無い局面は選べない"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "試せること + 答え合わせの表の行。本数は ⑤ で人が決める",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "menuId", "itemRef"],
        "properties": {
          "slot": { "type": "string", "pattern": "^act\\.[1-9][0-9]*$" },
          "menuId": {
            "type": "string",
            "pattern": "^M[1-9]$",
            "description": "承認済みの行動の表の id。【実在は道具が lib/answerMenu.ts の ANSWER_MENU と照合する】(S-6)― 9 件の一覧を schema に写すと、表が変わったとき黙ってずれる。【M10 を落とすのは意図どおり】表が 10 件になった日に黙って通るのではなく、ここで落ちて気づく(司令塔 2026-10-01)"
          },
          "itemRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seatIndex", "hypothesisId"],
            "properties": {
              "seatIndex": { "type": "integer", "minimum": 0 },
              "hypothesisId": { "type": "string", "minLength": 3, "pattern": "[A-Za-z0-9]" }
            }
          }
        }
      }
    },
    "humanQueue": {
      "type": "array",
      "description": "承認済みの表に無い行動候補の隔離先。【冊子に出ない】人間が表に足したものだけが冊子に出る(上位正本 §2 の 3)。捨てずにここへ置く",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemRef", "actionCandidateText", "why"],
        "properties": {
          "itemRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seatIndex", "hypothesisId"],
            "properties": {
              "seatIndex": { "type": "integer", "minimum": 0 },
              "hypothesisId": { "type": "string", "minLength": 3, "pattern": "[A-Za-z0-9]" }
            }
          },
          "actionCandidateText": { "type": "string", "minLength": 4 },
          "why": { "type": "string", "minLength": 4 }
        }
      }
    },
    "adoptedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["who", "at", "basis"],
      "description": "承認の根拠(委任の条件 2「承認には根拠を書く」)。【機械が埋めない】空のままなら段 exit-select が止まる",
      "properties": {
        "who": { "enum": ["commander", "human"] },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
        "basis": {
          "type": "string",
          "minLength": 10,
          "description": "何を見て採ったか。【席の一致を書かない】基準は「検証を通った + 問いに合う」(規則 8 の (2))。自由文なので言い換えた一致は機械で捕まらない ― 小さな黒名簿は道具が持つが弱い検査である(計画 §2a)"
        }
      }
    }
  }
}
