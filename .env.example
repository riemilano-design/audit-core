# 3 席 LLM API(束 R4)が読む変数の見本。**この見本に鍵の値を書かない**(鍵は .env = gitignore にだけ置く)。
# 読む場所は scripts/playtest/lib/env.ts の 1 か所。値を dump する口は無く、保存物・ログ・例外にも出さない。
# 使い方: cp .env.example .env して、鍵と値を人間が入れる。
#   下見(鍵を使わず束と概算だけ): npx tsx scripts/playtest/runSeats.ts … --dry-run

# ---- 鍵(人間が入れる。見本は空のまま)----
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- 席のモデル(2026-09-30 の司令塔・人間の決定。**別名を使わない** ― 周をまたいで席を比べるので、動く別名では比べられない)----
SEAT_GPT_MODEL=gpt-5.5
SEAT_GEMINI_MODEL=gemini-3.1-pro-preview
SEAT_CLAUDE_MODEL=claude-opus-5

# ---- 整理役(席と同じ社でよい ― 整理役は席の出力を見る立場で、独立性は席どうしに求める)----
INTEGRATOR_PROVIDER=anthropic
INTEGRATOR_MODEL=claude-opus-5

# ---- 単価(USD / 100 万トークン。**無いと費用が 0 に見えて上限が効かないので、実行は止まる**)----
PRICE_GPT_INPUT=5
PRICE_GPT_OUTPUT=30
PRICE_GEMINI_INPUT=2
PRICE_GEMINI_OUTPUT=12
PRICE_CLAUDE_INPUT=5
PRICE_CLAUDE_OUTPUT=25

# ---- 入力が大きいと上がる段(2026-09-30 司令塔): Gemini は入力 200k 超で単価が上がる。
#      3 つ揃って初めて段として扱う。**揃っていないと段なしで見積もる = 大きい入力で安く見える**(警告が出る)。
PRICE_GEMINI_TIER_ABOVE_TOKENS=200000
PRICE_GEMINI_INPUT_HIGH=4
PRICE_GEMINI_OUTPUT_HIGH=18

# ---- 費用の上限(1 回の実行の累計。既定の 2 回回しでは 2 回の累計に掛かる)----
SEAT_COST_CAP_USD=10

# ---- その社の入力上限(トークン。置かなければ費用だけで見る)----
SEAT_GPT_INPUT_LIMIT=
SEAT_GEMINI_INPUT_LIMIT=
SEAT_CLAUDE_INPUT_LIMIT=
